{
  "schemaVersion": 1,
  "note": "签名表：每条描述一个软件如何定位、有哪些缓存/数据目录。探针通用，不为软件写代码。",
  "workloads": [
    {
      "id": "workload.latex",
      "name": "TeX Live / LaTeX",
      "playbook": "playbooks/apps-latex-triage.md",
      "detect": [
        {
          "type": "command",
          "name": "pdflatex.exe",
          "as": "texRoot",
          "trim": 3
        },
        {
          "type": "path",
          "path": "C:\\texlive",
          "as": "texRoot"
        },
        {
          "type": "path",
          "path": "D:\\Programs\\texlive",
          "as": "texRoot"
        }
      ],
      "measure": [
        {
          "path": "{texRoot}\\texmf-var",
          "kind": "cache",
          "label": "TeX 缓存(texmf-var: 字体/luatex)"
        },
        {
          "path": "{texRoot}\\texmf-dist",
          "kind": "data",
          "label": "TeX 发行版(勿删)",
          "skipSize": true
        }
      ],
      "cautions": [
        "texmf-dist 是发行版本体，删了就得重装",
        "清 texmf-var 后首次编译会变慢（重建缓存）"
      ]
    },
    {
      "id": "workload.jetbrains",
      "name": "JetBrains IDE (PyCharm / IntelliJ)",
      "playbook": "playbooks/apps-jetbrains-triage.md",
      "detect": [
        {
          "type": "path",
          "path": "%APPDATA%\\JetBrains",
          "as": "jbRoaming"
        },
        {
          "type": "path",
          "path": "%LOCALAPPDATA%\\JetBrains",
          "as": "jbLocal"
        }
      ],
      "measure": [
        {
          "path": "{jbLocal}\\*\\caches",
          "kind": "cache",
          "label": "IDE 索引缓存"
        },
        {
          "path": "{jbLocal}\\*\\index",
          "kind": "cache",
          "label": "IDE 索引"
        },
        {
          "path": "{jbLocal}\\*\\log",
          "kind": "cache",
          "label": "IDE 日志"
        },
        {
          "path": "{jbRoaming}\\*",
          "kind": "config",
          "label": "IDE 配置与插件"
        }
      ],
      "cautions": [
        "caches/index 删了会重建（首次打开项目变慢）",
        "config 里是插件与设置，不要当缓存删"
      ]
    },
    {
      "id": "workload.steam",
      "name": "Steam",
      "playbook": "playbooks/apps-steam-triage.md",
      "detect": [
        {
          "type": "registry",
          "path": "HKCU:\\Software\\Valve\\Steam",
          "name": "SteamPath",
          "as": "steamRoot"
        },
        {
          "type": "command",
          "name": "steam.exe",
          "as": "steamRoot",
          "trim": 1
        }
      ],
      "measure": [
        {
          "path": "{steamRoot}\\steamapps\\shadercache",
          "kind": "cache",
          "label": "着色器缓存"
        },
        {
          "path": "{steamRoot}\\appcache",
          "kind": "cache",
          "label": "应用缓存"
        },
        {
          "path": "{steamRoot}\\depotcache",
          "kind": "cache",
          "label": "下载缓存"
        },
        {
          "path": "{steamRoot}\\steamapps\\common",
          "kind": "data",
          "label": "游戏库(勿删)"
        }
      ],
      "cautions": [
        "shadercache 删了会让游戏首次加载变慢",
        "游戏本体要挪就移到别的库文件夹，不要删"
      ]
    },
    {
      "id": "workload.zotero",
      "name": "Zotero",
      "playbook": "playbooks/apps-zotero-triage.md",
      "detect": [
        {
          "type": "path",
          "path": "%USERPROFILE%\\Zotero",
          "as": "zoteroData"
        },
        {
          "type": "path",
          "path": "%APPDATA%\\Zotero",
          "as": "zoteroProfile"
        }
      ],
      "measure": [
        {
          "path": "{zoteroData}\\storage",
          "kind": "data",
          "label": "附件存储"
        },
        {
          "path": "{zoteroData}\\zotero.sqlite",
          "kind": "data",
          "label": "文献数据库文件"
        },
        {
          "path": "{zoteroProfile}\\*",
          "kind": "config",
          "label": "配置与插件"
        }
      ],
      "cautions": [
        "storage 里是 PDF 附件本体，删了文献就断链",
        "zotero.sqlite 是数据库，动之前必须备份"
      ]
    },
    {
      "id": "workload.office-word",
      "name": "Microsoft Office / Word",
      "playbook": "playbooks/apps-word-triage.md",
      "detect": [
        {
          "type": "registry",
          "path": "HKCU:\\Software\\Microsoft\\Office\\16.0\\Word",
          "name": "Options",
          "as": "wordOpt",
          "optional": true
        },
        {
          "type": "path",
          "path": "%APPDATA%\\Microsoft\\Templates",
          "as": "officeTemplates"
        }
      ],
      "measure": [
        {
          "path": "{officeTemplates}\\Normal.dotm",
          "kind": "config",
          "label": "Word 默认模板(损坏会导致每次启动异常)"
        },
        {
          "path": "%LOCALAPPDATA%\\Microsoft\\Office\\16.0\\OfficeFileCache",
          "kind": "cache",
          "label": "Office 文档缓存"
        },
        {
          "path": "%LOCALAPPDATA%\\Microsoft\\Office\\Unsupported",
          "kind": "cache",
          "label": "Office 兼容性缓存",
          "optional": true
        }
      ],
      "cautions": [
        "Normal.dotm 损坏时删除即可重建，但会丢自定义样式",
        "改模板前先关掉所有 Office 程序"
      ]
    },
    {
      "id": "workload.tencent-video",
      "name": "腾讯视频 (QQLive)",
      "playbook": "playbooks/apps-migrate-to-another-drive.md",
      "detect": [
        {
          "type": "path",
          "path": "%APPDATA%\\Tencent\\QQLive",
          "as": "qqLive"
        },
        {
          "type": "path",
          "path": "%APPDATA%\\Tencent",
          "as": "tcRoot"
        }
      ],
      "measure": [
        {
          "path": "{qqLive}",
          "kind": "review",
          "label": "腾讯视频数据（可能含已下载视频）"
        },
        {
          "path": "{tcRoot}\\xwechat",
          "kind": "config",
          "label": "同目录下的微信程序数据（不属本项）",
          "optional": true
        }
      ],
      "cautions": [
        "里面可能有用户主动下载的影视文件",
        "删除前必须确认；清理缓存请用客户端内「清理缓存」"
      ]
    },
    {
      "id": "workload.wechat",
      "name": "微信 (WeChat)",
      "playbook": "playbooks/apps-migrate-to-another-drive.md",
      "detect": [
        {
          "type": "path",
          "path": "%APPDATA%\\Tencent",
          "as": "tencentAppData"
        }
      ],
      "measure": [
        {
          "path": "{kfDocuments}\\WeChat Files",
          "kind": "data",
          "label": "微信 3.x 聊天记录（在「文档」下）"
        },
        {
          "path": "{kfDocuments}\\xwechat_files",
          "kind": "data",
          "label": "微信 4.x 聊天记录（在「文档」下）"
        },
        {
          "path": "{kfDocuments}\\Tencent Files",
          "kind": "data",
          "label": "QQ/腾讯文件（在「文档」下）"
        },
        {
          "path": "{tencentAppData}\\xwechat",
          "kind": "config",
          "label": "微信程序数据（配置/缓存，勿删）"
        },
        {
          "path": "{tencentAppData}\\WeChat",
          "kind": "config",
          "label": "微信程序数据（旧版，勿删）"
        }
      ],
      "cautions": [
        "聊天记录是用户数据，禁止删除",
        "「文档」已搬走时，先搬后装的软件会自动落到新位置；先装后搬则必须同步改软件内的保存路径",
        "微信的保存路径在：设置 → 文件管理"
      ]
    },
    {
      "id": "workload.tencent-meeting",
      "name": "腾讯会议 (WeMeet)",
      "playbook": "playbooks/apps-sync-clients-triage.md",
      "detect": [
        {
          "type": "path",
          "path": "%APPDATA%\\Tencent\\WeMeet",
          "as": "weMeet"
        }
      ],
      "measure": [
        {
          "path": "{weMeet}",
          "kind": "cache",
          "label": "会议缓存（日志/临时文件/安装包）"
        }
      ],
      "cautions": [
        "会议录制文件若保存在此处，删前确认",
        "退出客户端后再清"
      ]
    },
    {
      "id": "workload.onedrive",
      "name": "OneDrive 客户端",
      "playbook": "playbooks/apps-sync-clients-triage.md",
      "detect": [
        {
          "type": "path",
          "path": "%LOCALAPPDATA%\\Microsoft\\OneDrive",
          "as": "odLocal"
        }
      ],
      "measure": [
        {
          "path": "{odLocal}\\logs",
          "kind": "cache",
          "label": "客户端日志"
        },
        {
          "path": "{odLocal}\\ListSync",
          "kind": "cache",
          "label": "同步列表缓存"
        },
        {
          "path": "{odLocal}\\Update",
          "kind": "cache",
          "label": "更新包残留"
        },
        {
          "path": "{odLocal}\\settings",
          "kind": "config",
          "label": "客户端设置（勿删）"
        }
      ],
      "cautions": [
        "云端文件本身不在这里，删本地缓存不会丢文件",
        "不要删 settings，会要求重新登录"
      ]
    },
    {
      "id": "workload.netease-music",
      "name": "网易云音乐",
      "playbook": "playbooks/apps-sync-clients-triage.md",
      "detect": [
        {
          "type": "path",
          "path": "%LOCALAPPDATA%\\Netease\\CloudMusic",
          "as": "neRoot"
        }
      ],
      "measure": [
        {
          "path": "{neRoot}\\Cache",
          "kind": "cache",
          "label": "流媒体缓存"
        }
      ],
      "cautions": [
        "下载的音乐默认在别的目录，删缓存不影响已下载歌曲"
      ]
    },
    {
      "id": "workload.dev-caches",
      "name": "开发缓存 (npm / pnpm)",
      "playbook": "playbooks/apps-dev-cache-triage.md",
      "detect": [
        {
          "type": "path",
          "path": "%LOCALAPPDATA%\\npm-cache",
          "as": "npmCache"
        },
        {
          "type": "path",
          "path": "%LOCALAPPDATA%\\pnpm\\store",
          "as": "pnpmStore"
        }
      ],
      "measure": [
        {
          "path": "{npmCache}",
          "kind": "cache",
          "label": "npm 缓存"
        },
        {
          "path": "{pnpmStore}",
          "kind": "cache",
          "label": "pnpm 全局存储"
        }
      ],
      "cautions": [
        "清 npm 缓存用 npm cache clean --force，别手删目录",
        "pnpm store 可用 pnpm store prune 精确清理"
      ]
    },
    {
      "id": "workload.calibre",
      "name": "Calibre",
      "playbook": "playbooks/storage-large-folder-management.md",
      "detect": [
        {
          "type": "path",
          "path": "%USERPROFILE%\\Calibre Library",
          "as": "calibreLib"
        }
      ],
      "measure": [
        {
          "path": "{calibreLib}",
          "kind": "data",
          "label": "书库（电子书本体）"
        }
      ],
      "cautions": [
        "书库是用户数据，处理方式只有迁移或删书"
      ]
    },
    {
      "id": "workload.obs",
      "name": "OBS Studio",
      "playbook": "playbooks/apps-sync-clients-triage.md",
      "detect": [
        {
          "type": "path",
          "path": "%APPDATA%\\obs-studio",
          "as": "obsCfg"
        }
      ],
      "measure": [
        {
          "path": "{obsCfg}",
          "kind": "config",
          "label": "场景与配置（含录屏路径设置）"
        }
      ],
      "cautions": [
        "配置里有推流密钥，不要外传",
        "录像默认不在这里"
      ]
    },
    {
      "id": "workload.adobe",
      "name": "Adobe Creative Cloud",
      "playbook": "playbooks/storage-large-folder-management.md",
      "detect": [
        {
          "type": "path",
          "path": "%APPDATA%\\Adobe\\Common",
          "as": "adobeCommon"
        }
      ],
      "measure": [
        {
          "path": "{adobeCommon}\\Media Cache Files",
          "kind": "cache",
          "label": "媒体缓存文件"
        },
        {
          "path": "{adobeCommon}\\Media Cache",
          "kind": "cache",
          "label": "媒体缓存数据库"
        }
      ],
      "cautions": [
        "缓存重建后首次预览会变慢",
        "工程文件不在这里，删缓存不会丢项目"
      ]
    },
    {
      "id": "workload.vmware",
      "name": "VMware Workstation",
      "playbook": "playbooks/apps-migrate-to-another-drive.md",
      "detect": [
        {
          "type": "path",
          "path": "%APPDATA%\\VMware",
          "as": "vmCfg"
        },
        {
          "type": "path",
          "path": "%USERPROFILE%\\Documents\\Virtual Machines",
          "as": "vmStore"
        }
      ],
      "measure": [
        {
          "path": "{vmStore}",
          "kind": "data",
          "label": "虚拟机磁盘（冷数据，容量优先）"
        },
        {
          "path": "{vmCfg}",
          "kind": "config",
          "label": "虚拟机配置（勿删）"
        }
      ],
      "cautions": [
        "虚拟机目录动辄几十上百 GB，迁移前必须关机并确认快照已合并"
      ]
    },
    {
      "id": "workload.adobe-premiere",
      "name": "Adobe Premiere Pro",
      "playbook": "playbooks/apps-adobe-triage.md",
      "detect": [
        {
          "type": "path",
          "path": "%APPDATA%\\Adobe\\Premiere Pro",
          "as": "prCfg"
        }
      ],
      "measure": [
        {
          "path": "%APPDATA%\\Adobe\\Common\\Media Cache Files",
          "kind": "cache",
          "label": "媒体缓存文件（编辑时高频读写）"
        },
        {
          "path": "%APPDATA%\\Adobe\\Common\\Media Cache",
          "kind": "cache",
          "label": "媒体缓存数据库"
        },
        {
          "path": "{prCfg}",
          "kind": "config",
          "label": "Premiere 配置"
        }
      ],
      "cautions": [
        "媒体缓存供实时预览使用，放在固态上才不卡；它会在项目关闭后自动回收"
      ]
    },
    {
      "id": "workload.adobe-photoshop",
      "name": "Adobe Photoshop",
      "playbook": "playbooks/apps-adobe-triage.md",
      "detect": [
        {
          "type": "path",
          "path": "%APPDATA%\\Adobe\\Adobe Photoshop 2024",
          "as": "psCfg"
        }
      ],
      "measure": [
        {
          "path": "{psCfg}",
          "kind": "cache",
          "label": "Photoshop 设置与缓存"
        }
      ],
      "cautions": [
        "暂存盘（Scratch Disk）默认在系统盘临时目录，属热数据，**建议保留在最快的固态**",
        "暂存盘不当会报「暂存盘已满」，不是磁盘真的满了"
      ]
    }
  ]
}
