{
  "schemaVersion": 1,
  "note": "鉴别诊断：只描述「要看什么」，不写结论。结论由 Agent 结合事实判断。",
  "diagnoses": [
    {
      "id": "dx.cdisk-full",
      "title": "C 盘空间不足：鉴别诊断",
      "requiredProbes": [
        "probe.host",
        "probe.drive-space",
        "probe.system-files",
        "probe.recycle-bin",
        "probe.browser-cache",
        "probe.app-caches",
        "probe.workloads",
        "probe.recovery-readiness"
      ],
      "hypotheses": [
        {
          "id": "h.hiberfil",
          "name": "休眠文件占用",
          "why": "hiberfil.sys 通常等于内存的 40-100%，关闭休眠即可释放",
          "checks": [
            {
              "metric": "storage.hiberfilGB",
              "signal": ">4 GB 视为显著"
            }
          ],
          "evidence": [
            "ev.hiberfil"
          ]
        },
        {
          "id": "h.recycle",
          "name": "回收站堆积",
          "why": "删除但未清空，长期累积",
          "checks": [
            {
              "metric": "storage.recycleGB",
              "signal": ">2 GB"
            }
          ],
          "evidence": [
            "ev.recycle"
          ]
        },
        {
          "id": "h.browser-cache",
          "name": "浏览器缓存",
          "why": "可重建，长期不清理会堆积",
          "checks": [
            {
              "metric": "storage.browserCacheGB",
              "signal": ">1 GB"
            }
          ],
          "evidence": [
            "ev.browser-cache"
          ]
        },
        {
          "id": "h.app-caches",
          "name": "应用缓存（腾讯系/OneDrive 等）",
          "why": "日志、更新包、同步缓存",
          "checks": [
            {
              "metric": "storage.appCachesGB",
              "signal": ">2 GB"
            }
          ],
          "evidence": [
            "ev.app-caches"
          ]
        },
        {
          "id": "h.workload-cache",
          "name": "具体软件缓存（TeX/IDE/Steam 等）",
          "why": "可重建，但部分目录混合用户数据，需先确认",
          "checks": [
            {
              "metric": "workloads.totalCacheGB",
              "signal": ">5 GB"
            }
          ],
          "evidence": [
            "ev.workloads"
          ]
        },
        {
          "id": "h.growth",
          "name": "近期异常增长（真正的病因）",
          "why": "若某指标 7 天内涨了几 GB，清缓存治标不治本",
          "checks": [
            {
              "metric": "volume.freeGB",
              "signal": "7 天内下降 >5 GB",
              "days": 7
            }
          ],
          "evidence": [
            "ev.trend"
          ]
        },
        {
          "id": "h.shadow",
          "name": "还原点/卷影副本堆积",
          "why": "卷影副本/还原点会占用可观空间；数量可直接看，实际占用需 vssadmin 查询",
          "checks": [
            {
              "metric": "recovery.shadowCopies",
              "signal": ">0 时用 vssadmin list shadowstorage 查实际占用"
            }
          ],
          "evidence": [
            "ev.restore-point"
          ]
        }
      ]
    },
    {
      "id": "dx.proxy-unreachable",
      "title": "网络异常：代理与连通性鉴别诊断",
      "requiredProbes": [
        "probe.network-adapters",
        "probe.dns-config",
        "probe.proxy-config"
      ],
      "hypotheses": [
        {
          "id": "h.proxy-off",
          "name": "系统代理未启用",
          "why": "被阻断的目标必须经代理，WinINET 未启用时依赖系统代理的程序会直连失败",
          "checks": [
            {
              "metric": "network.winInetProxyEnabled",
              "signal": "=0 且目标站点直连不通"
            }
          ],
          "evidence": [
            "ev.proxy-ports"
          ]
        },
        {
          "id": "h.env-missing",
          "name": "环境变量未设置",
          "why": "Node/Rust/Electron 等程序不读 WinINET，只认 HTTPS_PROXY",
          "checks": [
            {
              "metric": "network.envProxySet",
              "signal": "=0 时这类程序会绕过代理"
            }
          ],
          "evidence": [
            "ev.proxy-ports"
          ]
        },
        {
          "id": "h.conflict",
          "name": "多处代理配置不一致",
          "why": "WinINET / WinHTTP / 环境变量指向不同端口时，不同程序走不同出口，表现为「有的能用有的不能」",
          "checks": [
            {
              "metric": "network.proxyConsistent",
              "signal": "=0 即不一致"
            }
          ],
          "evidence": [
            "ev.proxy-ports"
          ]
        }
      ]
    },
    {
      "id": "dx.browser-derived-cache",
      "title": "浏览器衍生缓存：鉴别诊断",
      "requiredProbes": [
        "probe.cleanup-targets"
      ],
      "hypotheses": [
        {
          "id": "h.svc-worker",
          "name": "Service Worker 缓存",
          "why": "离线网页与 PWA 会在本地保留可观的缓存副本",
          "checks": [
            {
              "metric": "cleanup.edge-service-worker.GB",
              "signal": ">1 GB 视为显著"
            },
            {
              "metric": "cleanup.chrome-service-worker.GB",
              "signal": ">1 GB 视为显著"
            }
          ],
          "evidence": [
            "ev.edge-cache",
            "ev.chrome-cache"
          ]
        },
        {
          "id": "h.shader",
          "name": "着色器缓存",
          "why": "GPU 编译结果可重建，长期积累可达数百 MB",
          "checks": [
            {
              "metric": "cleanup.chrome-shader-cache.GB",
              "signal": ">0.3 GB"
            },
            {
              "metric": "cleanup.edge-shader-cache.GB",
              "signal": ">0.3 GB"
            }
          ],
          "evidence": [
            "ev.chrome-cache",
            "ev.edge-cache"
          ]
        },
        {
          "id": "h.code-cache",
          "name": "代码缓存",
          "why": "编译后的 JS 缓存，删掉只会让首次加载变慢",
          "checks": [
            {
              "metric": "cleanup.chrome-code-cache.GB",
              "signal": ">0.2 GB"
            },
            {
              "metric": "cleanup.edge-code-cache.GB",
              "signal": ">0.2 GB"
            }
          ],
          "evidence": [
            "ev.chrome-cache",
            "ev.edge-cache"
          ]
        }
      ]
    },
    {
      "id": "dx.dev-cache-bloat",
      "title": "开发缓存堆积：鉴别诊断",
      "requiredProbes": [
        "probe.cleanup-targets"
      ],
      "hypotheses": [
        {
          "id": "h.py",
          "name": "Python 包缓存",
          "why": "pip 会缓存下载过的 wheel，长期可达数 GB",
          "checks": [
            {
              "metric": "cleanup.pip-cache.GB",
              "signal": ">1 GB"
            }
          ],
          "evidence": [
            "ev.pip-cache"
          ]
        },
        {
          "id": "h.js",
          "name": "Node 包缓存",
          "why": "npm 缓存 tarball，反复安装会持续增长",
          "checks": [
            {
              "metric": "cleanup.npm-cache.GB",
              "signal": ">1 GB"
            }
          ],
          "evidence": [
            "ev.npm-cache"
          ]
        },
        {
          "id": "h.dotnet",
          "name": ".NET / JVM 缓存",
          "why": "NuGet 与 Gradle 都保留下载缓存",
          "checks": [
            {
              "metric": "cleanup.nuget-cache.GB",
              "signal": ">0.5 GB"
            },
            {
              "metric": "cleanup.gradle-cache.GB",
              "signal": ">2 GB"
            }
          ],
          "evidence": [
            "ev.nuget-cache",
            "ev.gradle-cache"
          ]
        },
        {
          "id": "h.model",
          "name": "模型缓存",
          "why": "HuggingFace 模型权重常达数十 GB，是最容易被忽视的大头",
          "checks": [
            {
              "metric": "cleanup.hf-cache.GB",
              "signal": ">10 GB"
            }
          ],
          "evidence": [
            "ev.hf-cache"
          ]
        }
      ]
    },
    {
      "id": "dx.crash-log-bloat",
      "title": "崩溃与日志堆积：鉴别诊断",
      "requiredProbes": [
        "probe.cleanup-targets"
      ],
      "hypotheses": [
        {
          "id": "h.dumps",
          "name": "崩溃转储",
          "why": "每个转储可能数百 MB，且很少再被查看",
          "checks": [
            {
              "metric": "cleanup.crash-dumps.GB",
              "signal": ">0.5 GB"
            }
          ],
          "evidence": [
            "ev.wer"
          ]
        },
        {
          "id": "h.wer",
          "name": "错误报告",
          "why": "用户级与系统级 WER 会长期累积",
          "checks": [
            {
              "metric": "cleanup.wer.GB",
              "signal": ">0.2 GB"
            },
            {
              "metric": "cleanup.wer-machine.GB",
              "signal": ">0.2 GB"
            }
          ],
          "evidence": [
            "ev.wer"
          ]
        },
        {
          "id": "h.cbs",
          "name": "组件安装日志",
          "why": "CBS 日志随更新持续增长，排查时才需要",
          "checks": [
            {
              "metric": "cleanup.cbs-logs.GB",
              "signal": ">0.3 GB"
            }
          ],
          "evidence": [
            "ev.cbs-logs"
          ]
        }
      ]
    },
    {
      "id": "dx.link-flaky",
      "title": "网络链路不稳定：鉴别诊断",
      "requiredProbes": [
        "probe.net-link",
        "probe.proxy-config"
      ],
      "hypotheses": [
        {
          "id": "h.stall",
          "name": "长连接中途停滞",
          "why": "短请求正常但传输中途停住，流式/实时应用会反复重连",
          "checks": [
            {
              "metric": "network.stallRate",
              "signal": ">0.1 视为不稳定（1/5 次停滞即 0.2）"
            }
          ],
          "evidence": [
            "ev.proxy-ports"
          ]
        },
        {
          "id": "h.proxy-down",
          "name": "代理不可达",
          "why": "代理端口在但不通，或进程已退出",
          "checks": [
            {
              "metric": "network.proxyOk",
              "signal": "=0 时所有经代理的请求都会失败"
            }
          ],
          "evidence": [
            "ev.proxy-ports"
          ]
        },
        {
          "id": "h.direct-blocked",
          "name": "直连被阻断",
          "why": "目标域名直连 TCP 全部失败，必须依赖代理；一旦代理抖动就无兜底",
          "checks": [
            {
              "metric": "network.directOkHosts",
              "signal": "=0 表示全部依赖代理"
            }
          ],
          "evidence": [
            "ev.proxy-ports"
          ]
        },
        {
          "id": "h.dns-fail",
          "name": "DNS 解析失败",
          "why": "解析不出来时连接会卡在超时，而不是快速失败",
          "checks": [
            {
              "metric": "network.dnsOkHosts",
              "signal": "小于 network.totalHosts 即部分域名解析异常"
            }
          ],
          "evidence": [
            "ev.proxy-ports"
          ]
        }
      ]
    }
  ]
}
