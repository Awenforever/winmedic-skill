{
  "schemaVersion": 1,
  "note": "鉴别诊断：只描述「要看什么」，不写结论。结论由 Agent 结合事实判断。",
  "diagnoses": [
    {
      "id": "dx.cdisk-full",
      "title": "C 盘空间不足：鉴别诊断",
      "requiredProbes": [
        "probe.host",
        "probe.drive-space",
        "probe.system-files",
        "probe.recycle-bin",
        "probe.browser-cache",
        "probe.app-caches",
        "probe.workloads",
        "probe.recovery-readiness"
      ],
      "hypotheses": [
        {
          "id": "h.hiberfil",
          "name": "休眠文件占用",
          "why": "hiberfil.sys 通常等于内存的 40-100%，关闭休眠即可释放",
          "checks": [
            {
              "metric": "storage.hiberfilGB",
              "signal": ">4 GB 视为显著"
            }
          ],
          "evidence": [
            "ev.hiberfil"
          ]
        },
        {
          "id": "h.recycle",
          "name": "回收站堆积",
          "why": "删除但未清空，长期累积",
          "checks": [
            {
              "metric": "storage.recycleGB",
              "signal": ">2 GB"
            }
          ],
          "evidence": [
            "ev.recycle"
          ]
        },
        {
          "id": "h.browser-cache",
          "name": "浏览器缓存",
          "why": "可重建，长期不清理会堆积",
          "checks": [
            {
              "metric": "storage.browserCacheGB",
              "signal": ">1 GB"
            }
          ],
          "evidence": [
            "ev.browser-cache"
          ]
        },
        {
          "id": "h.app-caches",
          "name": "应用缓存（腾讯系/OneDrive 等）",
          "why": "日志、更新包、同步缓存",
          "checks": [
            {
              "metric": "storage.appCachesGB",
              "signal": ">2 GB"
            }
          ],
          "evidence": [
            "ev.app-caches"
          ]
        },
        {
          "id": "h.workload-cache",
          "name": "具体软件缓存（TeX/IDE/Steam 等）",
          "why": "可重建，但部分目录混合用户数据，需先确认",
          "checks": [
            {
              "metric": "workloads.totalCacheGB",
              "signal": ">5 GB"
            }
          ],
          "evidence": [
            "ev.workloads"
          ]
        },
        {
          "id": "h.growth",
          "name": "近期异常增长（真正的病因）",
          "why": "若某指标 7 天内涨了几 GB，清缓存治标不治本",
          "checks": [
            {
              "metric": "volume.freeGB",
              "signal": "7 天内下降 >5 GB",
              "days": 7
            }
          ],
          "evidence": [
            "ev.trend"
          ]
        },
        {
          "id": "h.shadow",
          "name": "还原点/卷影副本堆积",
          "why": "卷影副本/还原点会占用可观空间；数量可直接看，实际占用需 vssadmin 查询",
          "checks": [
            {
              "metric": "recovery.shadowCopies",
              "signal": ">0 时用 vssadmin list shadowstorage 查实际占用"
            }
          ],
          "evidence": [
            "ev.restore-point"
          ]
        }
      ]
    },
    {
      "id": "dx.proxy-unreachable",
      "title": "网络异常：代理与连通性鉴别诊断",
      "requiredProbes": [
        "probe.network-adapters",
        "probe.dns-config",
        "probe.proxy-config"
      ],
      "hypotheses": [
        {
          "id": "h.proxy-off",
          "name": "系统代理未启用",
          "why": "被阻断的目标必须经代理，WinINET 未启用时依赖系统代理的程序会直连失败",
          "checks": [
            {
              "metric": "network.winInetProxyEnabled",
              "signal": "=0 且目标站点直连不通"
            }
          ],
          "evidence": [
            "ev.proxy-ports"
          ]
        },
        {
          "id": "h.env-missing",
          "name": "环境变量未设置",
          "why": "Node/Rust/Electron 等程序不读 WinINET，只认 HTTPS_PROXY",
          "checks": [
            {
              "metric": "network.envProxySet",
              "signal": "=0 时这类程序会绕过代理"
            }
          ],
          "evidence": [
            "ev.proxy-ports"
          ]
        },
        {
          "id": "h.conflict",
          "name": "多处代理配置不一致",
          "why": "WinINET / WinHTTP / 环境变量指向不同端口时，不同程序走不同出口，表现为「有的能用有的不能」",
          "checks": [
            {
              "metric": "network.proxyConsistent",
              "signal": "=0 即不一致"
            }
          ],
          "evidence": [
            "ev.proxy-ports"
          ]
        }
      ]
    },
    {
      "id": "dx.browser-derived-cache",
      "title": "浏览器衍生缓存：鉴别诊断",
      "requiredProbes": [
        "probe.cleanup-targets"
      ],
      "hypotheses": [
        {
          "id": "h.svc-worker",
          "name": "Service Worker 缓存",
          "why": "离线网页与 PWA 会在本地保留可观的缓存副本",
          "checks": [
            {
              "metric": "cleanup.edge-service-worker.GB",
              "signal": ">1 GB 视为显著"
            },
            {
              "metric": "cleanup.chrome-service-worker.GB",
              "signal": ">1 GB 视为显著"
            }
          ],
          "evidence": [
            "ev.edge-cache",
            "ev.chrome-cache"
          ]
        },
        {
          "id": "h.shader",
          "name": "着色器缓存",
          "why": "GPU 编译结果可重建，长期积累可达数百 MB",
          "checks": [
            {
              "metric": "cleanup.chrome-shader-cache.GB",
              "signal": ">0.3 GB"
            },
            {
              "metric": "cleanup.edge-shader-cache.GB",
              "signal": ">0.3 GB"
            }
          ],
          "evidence": [
            "ev.chrome-cache",
            "ev.edge-cache"
          ]
        },
        {
          "id": "h.code-cache",
          "name": "代码缓存",
          "why": "编译后的 JS 缓存，删掉只会让首次加载变慢",
          "checks": [
            {
              "metric": "cleanup.chrome-code-cache.GB",
              "signal": ">0.2 GB"
            },
            {
              "metric": "cleanup.edge-code-cache.GB",
              "signal": ">0.2 GB"
            }
          ],
          "evidence": [
            "ev.chrome-cache",
            "ev.edge-cache"
          ]
        }
      ]
    },
    {
      "id": "dx.dev-cache-bloat",
      "title": "开发缓存堆积：鉴别诊断",
      "requiredProbes": [
        "probe.cleanup-targets"
      ],
      "hypotheses": [
        {
          "id": "h.py",
          "name": "Python 包缓存",
          "why": "pip 会缓存下载过的 wheel，长期可达数 GB",
          "checks": [
            {
              "metric": "cleanup.pip-cache.GB",
              "signal": ">1 GB"
            }
          ],
          "evidence": [
            "ev.pip-cache"
          ]
        },
        {
          "id": "h.js",
          "name": "Node 包缓存",
          "why": "npm 缓存 tarball，反复安装会持续增长",
          "checks": [
            {
              "metric": "cleanup.npm-cache.GB",
              "signal": ">1 GB"
            }
          ],
          "evidence": [
            "ev.npm-cache"
          ]
        },
        {
          "id": "h.dotnet",
          "name": ".NET / JVM 缓存",
          "why": "NuGet 与 Gradle 都保留下载缓存",
          "checks": [
            {
              "metric": "cleanup.nuget-cache.GB",
              "signal": ">0.5 GB"
            },
            {
              "metric": "cleanup.gradle-cache.GB",
              "signal": ">2 GB"
            }
          ],
          "evidence": [
            "ev.nuget-cache",
            "ev.gradle-cache"
          ]
        },
        {
          "id": "h.model",
          "name": "模型缓存",
          "why": "HuggingFace 模型权重常达数十 GB，是最容易被忽视的大头",
          "checks": [
            {
              "metric": "cleanup.hf-cache.GB",
              "signal": ">10 GB"
            }
          ],
          "evidence": [
            "ev.hf-cache"
          ]
        }
      ]
    },
    {
      "id": "dx.crash-log-bloat",
      "title": "崩溃与日志堆积：鉴别诊断",
      "requiredProbes": [
        "probe.cleanup-targets"
      ],
      "hypotheses": [
        {
          "id": "h.dumps",
          "name": "崩溃转储",
          "why": "每个转储可能数百 MB，且很少再被查看",
          "checks": [
            {
              "metric": "cleanup.crash-dumps.GB",
              "signal": ">0.5 GB"
            }
          ],
          "evidence": [
            "ev.wer"
          ]
        },
        {
          "id": "h.wer",
          "name": "错误报告",
          "why": "用户级与系统级 WER 会长期累积",
          "checks": [
            {
              "metric": "cleanup.wer.GB",
              "signal": ">0.2 GB"
            },
            {
              "metric": "cleanup.wer-machine.GB",
              "signal": ">0.2 GB"
            }
          ],
          "evidence": [
            "ev.wer"
          ]
        },
        {
          "id": "h.cbs",
          "name": "组件安装日志",
          "why": "CBS 日志随更新持续增长，排查时才需要",
          "checks": [
            {
              "metric": "cleanup.cbs-logs.GB",
              "signal": ">0.3 GB"
            }
          ],
          "evidence": [
            "ev.cbs-logs"
          ]
        }
      ]
    },
    {
      "id": "dx.link-flaky",
      "title": "网络链路不稳定：鉴别诊断",
      "requiredProbes": [
        "probe.net-link",
        "probe.proxy-config"
      ],
      "hypotheses": [
        {
          "id": "h.stall",
          "name": "长连接中途停滞",
          "why": "短请求正常但传输中途停住，流式/实时应用会反复重连",
          "checks": [
            {
              "metric": "network.stallRate",
              "signal": ">0.1 视为不稳定（1/5 次停滞即 0.2）"
            }
          ],
          "evidence": [
            "ev.proxy-ports"
          ]
        },
        {
          "id": "h.proxy-down",
          "name": "代理不可达",
          "why": "代理端口在但不通，或进程已退出",
          "checks": [
            {
              "metric": "network.proxyOk",
              "signal": "=0 时所有经代理的请求都会失败"
            }
          ],
          "evidence": [
            "ev.proxy-ports"
          ]
        },
        {
          "id": "h.direct-blocked",
          "name": "直连被阻断",
          "why": "目标域名直连 TCP 全部失败，必须依赖代理；一旦代理抖动就无兜底",
          "checks": [
            {
              "metric": "network.directOkHosts",
              "signal": "=0 表示全部依赖代理"
            }
          ],
          "evidence": [
            "ev.proxy-ports"
          ]
        },
        {
          "id": "h.dns-fail",
          "name": "DNS 解析失败",
          "why": "解析不出来时连接会卡在超时，而不是快速失败",
          "checks": [
            {
              "metric": "network.dnsOkHosts",
              "signal": "小于 network.totalHosts 即部分域名解析异常"
            }
          ],
          "evidence": [
            "ev.proxy-ports"
          ]
        }
      ]
    },
    {
      "id": "dx.bt-audio",
      "title": "蓝牙音频：提示音正常而应用无声",
      "requiredProbes": [
        "probe.host",
        "probe.audio-endpoints",
        "probe.audio-app-routing",
        "probe.audio-services"
      ],
      "hypotheses": [
        {
          "id": "h.bt-link",
          "name": "蓝牙链路/端点未激活",
          "why": "端点不在活跃状态时，任何应用都发不出声",
          "checks": [
            {
              "metric": "audio.btActive",
              "signal": "=0 表示没有活跃蓝牙渲染端点；=1 表示链路层正常"
            }
          ],
          "evidence": []
        },
        {
          "id": "h.app-routing",
          "name": "每应用路由指向已断开的设备",
          "why": "应用被固定在旧耳机/设备上，系统提示音走默认设备仍然正常",
          "checks": [
            {
              "metric": "audio.staleRoutes",
              "signal": ">0：已配对设备当前无活跃端点，但有应用被钉在它上面（历史残留不计入）"
            }
          ],
          "evidence": []
        },
        {
          "id": "h.audio-engine",
          "name": "音频服务/引擎未全部运行",
          "why": "Audiosrv/EndpointBuilder 异常时整个音频栈不工作",
          "checks": [
            {
              "metric": "audio.servicesOk",
              "signal": "=0 表示有必需服务未运行"
            }
          ],
          "evidence": []
        },
        {
          "id": "h.hfp",
          "name": "Hands-Free 节点异常",
          "why": "HFP 节点损坏可能导致端点映射混乱（历史上禁用 HFP 会留下 Unknown 节点）",
          "checks": [
            {
              "metric": "audio.hfpNotOk",
              "signal": ">0 表示存在状态异常的 Hands-Free 节点"
            }
          ],
          "evidence": []
        },
        {
          "id": "h.orphan-routes",
          "name": "历史残留路由（设备已不在系统）",
          "why": "换过耳机/重装后遗留的路由，通常无害，只在排查噪声时需要清理",
          "checks": [
            {
              "metric": "audio.orphanRoutes",
              "signal": ">0：存在指向已不存在设备的路由，通常不必处理"
            }
          ],
          "evidence": []
        }
      ]
    },
    {
      "id": "dx.media-timestamp",
      "title": "媒体时间与文件系统不一致（复制后时间跳到未来）",
      "requiredProbes": [
        "probe.host",
        "probe.media-timestamps"
      ],
      "hypotheses": [
        {
          "id": "h.tz-offset",
          "name": "拍摄设备时区设置错误（本地时间按 UTC 写入）",
          "why": "偏移精确接近 ±8 小时（或其他整时区差）时，通常是设备把本地时间当 UTC 写入元数据",
          "checks": [
            {
              "metric": "media.maxOffsetHours",
              "signal": "绝对值 >= 1h；接近 8h 时高度指向时区错位"
            }
          ],
          "evidence": []
        },
        {
          "id": "h.partial",
          "name": "部分文件元数据缺失或由第三方写入",
          "why": "只有部分样本偏移，可能是转码、剪辑或同步工具改写了元数据",
          "checks": [
            {
              "metric": "media.shiftedFiles",
              "signal": ">0 表示存在偏移样本；结合样本总数判断是否普遍"
            }
          ],
          "evidence": []
        }
      ]
    },
    {
      "id": "dx.usb-worm",
      "title": "U 盘快捷方式蠕虫：鉴别诊断",
      "requiredProbes": [
        "probe.host",
        "probe.usb-worm"
      ],
      "hypotheses": [
        {
          "id": "h.shortcut",
          "name": "根目录存在可疑快捷方式",
          "why": "指向 cmd/powershell 或参数含 DrvSvc/Mgrsvr，是此类蠕虫的入口",
          "checks": [
            {
              "metric": "usb.suspiciousShortcuts",
              "signal": ">0 即存在可疑快捷方式"
            }
          ],
          "evidence": []
        },
        {
          "id": "h.hidden-data",
          "name": "用户数据被移入隐藏目录",
          "why": "文件夹「消失」通常是被移进单字符隐藏目录",
          "checks": [
            {
              "metric": "usb.hiddenDataItems",
              "signal": ">0 表示有数据藏在隐藏目录，先还原再清除"
            }
          ],
          "evidence": []
        },
        {
          "id": "h.infected",
          "name": "至少一支盘判定为感染",
          "why": "结合快捷方式、载荷名与 autorun 的确定性判级",
          "checks": [
            {
              "metric": "usb.infected",
              "signal": ">0 表示需要按 PB-603 处置"
            }
          ],
          "evidence": []
        }
      ]
    }
  ]
}
