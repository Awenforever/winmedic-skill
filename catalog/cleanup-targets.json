{
  "schemaVersion": 1,
  "note": "数据驱动的清理目标：探针按此表测量并产出候选；加目标 = 加一条数据。",
  "targets": [
    {
      "id": "clean.chrome-cache",
      "actionId": "storage.chrome-cache",
      "label": "Chrome 网页缓存",
      "paths": [
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\Default\\Cache"
      ],
      "kind": "dir",
      "tier": 2,
      "evidence": "ev.chrome-cache",
      "requires": [
        "process-not-running:chrome.exe"
      ],
      "plain": {
        "what": "Chrome 保存的网页缓存（图片、脚本等）",
        "why": "缓存只用于加速，删除后浏览器会自动重建",
        "consequence": "网页首次打开略慢；部分网站可能需要重新登录"
      }
    },
    {
      "id": "clean.chrome-code-cache",
      "actionId": "storage.chrome-code-cache",
