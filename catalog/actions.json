    {
      "id": "storage.winsxs-cleanup",
      "domain": "storage",
      "kind": "dism",
      "tier": 3,
      "risk": "medium",
      "command": "DISM /Online /Cleanup-Image /StartComponentCleanup",
      "evidence": "ev.winsxs",
      "reversible": "none",
      "requires": [
        "admin"
      ],
      "targetsProbe": "probe.winsxs",
      "cautions": [
        "不可逆（组件被删）",
        "清理后当场可用空间可能下降，重启后生效",
        "不要用 /ResetBase"
      ],
      "verify": [
        {
          "kind": "pending_reboot_hint"
        }
      ],
      "plain": {
        "what": "系统组件库（WinSxS）中被新版本取代的旧组件，通过 DISM 清理",
        "why": "DISM 会自行判断哪些旧组件可以安全移除",
        "consequence": "这是**全部动作里最重的一个**：清理后无法卸载已安装的更新，且**不能回滚**；过程可能 10-30 分钟，期间断电有风险，建议先建还原点"
      }
    },
