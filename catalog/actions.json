      "reversible": "partial",
      "rollback": "Get-ComputerRestorePoint | ... 由用户决定删除",
      "requires": [
        "admin"
      ],
      "standalone": true,
      "cautions": [
        "系统保护未启用时会失败",
        "可能耗时 1-3 分钟"
      ],
      "verify": [
        {
          "kind": "restore_point_exists"
        }
      ],
      "plain": {
        "what": "创建一个系统还原点",
        "why": "为后续的系统级操作提供一条退路",
        "consequence": "会占用几百 MB 到数 GB 磁盘空间；不修改任何个人文件"
      }
