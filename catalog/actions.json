      "id": "recovery.create-restore-point",
      "domain": "recovery",
      "kind": "command",
      "tier": 1,
      "risk": "none",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Checkpoint-Computer -Description winmedic -RestorePointType MODIFY_SETTINGS\"",
