      "tier": 3,
      "risk": "medium",
      "command": "DISM /Online /Cleanup-Image /StartComponentCleanup",
      "evidence": "ev.winsxs",
      "reversible": "none",
      "requires": [
        "admin"
      ],
      "targetsProbe": "probe.winsxs",
