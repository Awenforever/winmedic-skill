{
  "schemaVersion": 1,
  "actions": [
    {
      "id": "storage.recycle-bin-empty",
      "domain": "storage",
      "kind": "quarantine",
      "tier": 1,
      "risk": "none",
      "evidence": "ev.recycle-bin",
      "reversible": "full",
      "requires": [],
      "targetsProbe": "probe.recycle-bin",
      "verify": [
        {
          "kind": "path_size_lt",
          "path": "C:\\$Recycle.Bin",
          "bytes": 104857600
        }
      ],
      "plain": {
        "what": "回收站里已经被你删除的文件",
        "why": "回收站只是暂存区，清空它不影响任何正在使用的文件",
        "consequence": "清空后无法再从回收站找回这些文件；如需恢复要借助第三方恢复工具，且成功率不保证"
      }
    },
    {
      "id": "storage.hiberfil-off",
      "domain": "storage",
      "kind": "command",
      "tier": 1,
      "risk": "none",
      "command": "powercfg /h off",
      "evidence": "ev.hiberfil",
      "reversible": "full",
      "rollback": "powercfg /h on",
      "requires": [
        "admin"
      ],
      "targetsProbe": "probe.system-files",
      "cautions": [
        "若快速启动开启，会同时关闭快速启动"
      ],
      "verify": [
        {
          "kind": "system_file_absent",
          "path": "C:\\hiberfil.sys"
        }
      ],
      "plain": {
        "what": "休眠文件 hiberfil.sys，是系统休眠和快速启动时存放内存状态的快照",
        "why": "关闭休眠功能后该文件会被系统删除，日常使用不受影响",
        "consequence": "休眠功能不可用（合盖睡眠仍可用），快速启动失效、开机可能慢几秒；该文件不可恢复，但系统以后可以重新生成"
      }
    },
