{
  "schemaVersion": 1,
  "actions": [
    {
      "id": "storage.recycle-bin-empty",
      "domain": "storage",
      "kind": "quarantine",
      "tier": 1,
      "risk": "none",
      "evidence": "ev.recycle-bin",
      "reversible": "full",
      "requires": [],
      "targetsProbe": "probe.recycle-bin",
      "verify": [
        {
          "kind": "path_size_lt",
          "path": "C:\\$Recycle.Bin",
          "bytes": 104857600
        }
      ]
    },
    {
      "id": "storage.hiberfil-off",
      "domain": "storage",
      "kind": "command",
      "tier": 1,
      "risk": "none",
      "command": "powercfg /h off",
      "evidence": "ev.hiberfil",
      "reversible": "full",
      "rollback": "powercfg /h on",
      "requires": [
        "admin"
      ],
      "targetsProbe": "probe.system-files",
      "cautions": [
        "若快速启动开启，会同时关闭快速启动"
      ],
      "verify": [
        {
          "kind": "system_file_absent",
          "path": "C:\\hiberfil.sys"
        }
      ]
    },
