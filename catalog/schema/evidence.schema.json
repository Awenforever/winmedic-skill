{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WinMedic evidence catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "strength",
          "verifiedOn",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ev\\.[a-z0-9.-]+$"
          },
          "strength": {
            "enum": [
              "official",
              "indirect",
              "empirical"
            ]
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quote": {
            "type": "string"
          },
          "verifiedOn": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "notes": {
            "type": "string"
          }
        },
        "if": {
          "properties": {
            "strength": {
              "const": "official"
            }
          }
        },
        "then": {
          "required": [
            "links",
            "quote"
          ]
        }
      }
    }
  }
}
