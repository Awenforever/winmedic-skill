{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "diagnoses",
  "type": "object",
  "required": [
    "schemaVersion",
    "diagnoses"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "diagnoses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "hypotheses"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "requiredProbes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hypotheses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "checks"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "metric",
                      "signal"
                    ],
                    "properties": {
                      "metric": {
                        "type": "string"
                      },
                      "signal": {
                        "type": "string"
                      },
                      "days": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
