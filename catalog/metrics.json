{
  "schemaVersion": 1,
  "note": "指标的唯一事实源。诊断只能引用这里注册过的指标；未注册指标视为缺陷。",
  "metrics": [
    {
      "name": "volume.freeGB",
      "unit": "GB",
      "source": "trend",
      "note": "系统盘可用空间"
    },
    {
      "name": "storage.hiberfilGB",
      "unit": "GB",
      "source": "trend"
    },
    {
      "name": "storage.recycleGB",
      "unit": "GB",
      "source": "trend"
    },
    {
      "name": "storage.browserCacheGB",
      "unit": "GB",
      "source": "trend"
    },
    {
      "name": "storage.appCachesGB",
      "unit": "GB",
      "source": "trend"
    },
    {
      "name": "storage.officeCacheGB",
      "unit": "GB",
      "source": "trend"
    },
    {
      "name": "workloads.totalCacheGB",
      "unit": "GB",
      "source": "trend"
    },
    {
      "name": "recovery.shadowGB",
      "unit": "GB",
      "source": "trend"
    },
    {
      "name": "recovery.shadowCopies",
      "unit": "count",
      "source": "trend"
    },
    {
      "name": "recovery.restorePoints",
      "unit": "count",
      "source": "trend"
    },
    {
      "name": "cleanup.totalGB",
      "unit": "GB",
      "source": "trend",
      "note": "全部清理目标合计"
    },
    {
      "name": "network.winInetProxyEnabled",
      "unit": "flag",
      "source": "trend",
      "note": "1=系统代理已启用"
    },
    {
      "name": "network.envProxySet",
      "unit": "flag",
      "source": "trend",
      "note": "1=HTTPS_PROXY 已设置（非 WinINET 程序依赖它）"
    },
    {
      "name": "network.proxyConsistent",
      "unit": "flag",
      "source": "trend",
      "note": "1=WinINET/WinHTTP/环境变量三处一致或都没配"
    },
    {
      "name": "network.stallRate",
      "unit": "ratio",
      "source": "trend",
      "note": "长连接采样停滞率 0..1"
    },
    {
      "name": "network.dnsOkHosts",
      "unit": "count",
      "source": "trend"
    },
    {
      "name": "network.directOkHosts",
      "unit": "count",
      "source": "trend"
    },
    {
      "name": "network.totalHosts",
      "unit": "count",
      "source": "trend"
    },
    {
      "name": "network.proxyOk",
      "unit": "flag",
      "source": "trend"
    },
    {
      "name": "audio.activeRender",
      "unit": "count",
      "source": "trend",
      "note": "活跃渲染端点数"
    },
    {
      "name": "audio.btActive",
      "unit": "count",
      "source": "trend",
      "note": "活跃蓝牙渲染端点数"
    },
    {
      "name": "audio.staleRoutes",
      "unit": "count",
      "source": "trend",
      "note": "指向非活跃设备的每应用路由数"
    },
    {
      "name": "audio.hfpNotOk",
      "unit": "count",
      "source": "trend",
      "note": "状态异常的 Hands-Free 节点数"
    },
    {
      "name": "audio.servicesOk",
      "unit": "bool",
      "source": "trend",
      "note": "音频/蓝牙服务是否全部运行（1/0）"
    },
    {
      "name": "media.maxOffsetHours",
      "unit": "h",
      "source": "trend",
      "note": "媒体元数据与文件系统时间的最大绝对偏移"
    },
    {
      "name": "media.shiftedFiles",
      "unit": "count",
      "source": "trend",
      "note": "偏移超过 1 小时的样本数"
    },
    {
      "name": "audio.orphanRoutes",
      "unit": "count",
      "source": "trend",
      "note": "指向已不在系统中的蓝牙设备的历史路由数"
    },
    {
      "name": "network.deadProxies",
      "unit": "count",
      "source": "trend",
      "note": "本机回环代理端口无监听的个数"
    }
  ],
  "dynamicNamespaces": [
    {
      "pattern": "^cleanup\\.(?<id>.+)\\.GB$",
      "idTemplate": "clean.<id>",
      "definedIn": "catalog/cleanup-targets.json",
      "note": "每个清理目标一个指标，由目标表动态生成"
    }
  ]
}
